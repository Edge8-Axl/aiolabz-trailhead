# Trailhead — environment variables
# Copy to .env.local and fill in from your Supabase project (Settings > API).
# .env.local is gitignored. NEVER commit real keys.

# --- Supabase (required) ---
# Public: safe to expose to the browser (used by the client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: FULL ADMIN ACCESS, bypasses Row-Level Security.
# Never prefix with NEXT_PUBLIC_. Never expose to the browser. Server code only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Local Supabase (optional; only if running `supabase start` locally) ---
# Default local API URL printed by `supabase start`:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# --- Observability (optional) ---
# SENTRY_DSN=
