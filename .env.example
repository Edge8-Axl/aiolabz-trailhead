# Trailhead — environment variables
# Copy to .env.local and fill in from your Supabase project (Settings > API).
# .env.local is gitignored. NEVER commit real keys.

# --- Supabase (required) ---
# Public: safe to expose to the browser (used by the client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: FULL ADMIN ACCESS, bypasses Row-Level Security.
# Never prefix with NEXT_PUBLIC_. Never expose to the browser. Server code only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Local Supabase (optional; only if running `supabase start` locally) ---
# Default local API URL printed by `supabase start`:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# --- Resend (required for the transactional email channel) ---
# API key from https://resend.com/api-keys . Server-only; never NEXT_PUBLIC_.
RESEND_API_KEY=
# Sender identity. Without a verified domain, use Resend's shared sender below
# (it can ONLY deliver to your own Resend account email — fine for testing).
# Once you verify a domain, switch to e.g. "Trailhead <no-reply@yourdomain.com>".
RESEND_FROM=Trailhead <onboarding@resend.dev>
# Signing secret for the inbound delivery-events webhook (Resend → Svix).
# From the Resend webhook settings; looks like "whsec_...". Server-only.
RESEND_WEBHOOK_SECRET=

# --- Observability (optional) ---
# SENTRY_DSN=
